        {
          "item": "Nitrile Gloves (pair)",
          "quantity": 1
        }
      ],
      "instructions": [
        "Ask 'Are you choking?' — if they can cough forcefully, encourage coughing and do not intervene.",
        "For an ineffective cough: 5 sharp back blows between the shoulder blades.",
        "Then 5 abdominal thrusts (Heimlich). Alternate 5 and 5.",
        "If they become unresponsive, lower them to the ground and start CPR immediately.",
        "Anyone who received abdominal thrusts must be assessed afterwards even if they recover."
      ],
      "protocols": [
        "QR-06_heimlich_choking.pdf",
        "QR-02_CPR_AED.pdf"
