{
  "version": 1,
  "description": "Deterministic triage catalogue. Each rule maps report language onto a condition, a severity, the supplies a volunteer must carry and the protocol document that governs it. Used as the offline fallback when no LLM is reachable, and merged with LLM output otherwise. Item names must match data/inventory.csv.",
  "scoring": "strong_keywords count triple. confidence = min(0.95, 0.30 + 0.09 x score) plus up to +0.10 when RAG retrieved a cited protocol. A keyword written with '+' matches when every part appears anywhere in the report, in any order ('face+drooping' matches 'her face is drooping'). A rule needs score >= 2 (one strong keyword, or two ordinary ones) before it is offered as a diagnosis.",
  "rules": [
    {
      "id": "cardiac-arrest",
      "label": "Cardiac arrest / unresponsive casualty",
      "severity": "CRITICAL",
      "strong_keywords": [
        "cardiac arrest",
        "chest+not+moving",
        "heart attack",
        "heart+stopped",
        "no heartbeat",
        "no pulse",
        "no+pulse",
        "not breathing",
        "not+breathing",
        "stopped breathing"
      ],
      "keywords": [
        "blue lips",
        "chest pain",
        "clutching chest",
        "cold to touch",
        "collapsed",
        "cpr",
        "face down",
        "limp",
        "not moving",
        "unconscious",
        "unresponsive"
      ],
      "travel_time_min": 5,
      "resolution_time_min": 25,
      "materials": [
        {
          "item": "AED",
          "quantity": 1
        },
        {
          "item": "CPR Mask",
          "quantity": 1
        },
        {
          "item": "Nitrile Gloves (pair)",
          "quantity": 1
        }
      ],
      "instructions": [
        "Confirm the scene is safe, then check response and breathing for no more than 10 seconds.",
        "Send a second person for the AED immediately; do not leave the casualty alone if avoidable.",
        "Start chest compressions: 30 compressions at 100-120/min, 5-6 cm deep, then 2 rescue breaths with the CPR mask.",
        "Attach the AED as soon as it arrives, follow its voice prompts and stand clear for any shock.",
        "Continue until the casualty breathes normally or professional help takes over. Report the handover to base."
      ],
      "protocols": [
        "QR-02_CPR_AED.pdf",
        "MED-04_cardiac_stroke.pdf",
        "OPS-06_handoff_emergency_services.pdf"
      ],
      "notes": "Survival falls roughly 10% per minute without CPR — this rule always outranks queue position."
    },
