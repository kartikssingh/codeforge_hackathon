# ARIA configuration — copy to backend/.env and edit.
# Real environment variables win over this file; this file wins over defaults.
# Every key is optional: the defaults below are what ships.

# ── API ───────────────────────────────────────────────────────────────────────
# Keep the host on 127.0.0.1. The API has no authentication by design; it is
# meant to be reachable only from the laptop it runs on.
ARIA_API_HOST=127.0.0.1
ARIA_API_PORT=8000
ARIA_MAX_UPLOAD_BYTES=67108864
ARIA_MAX_CONCURRENT_PIPELINES=1

# ── Language model ────────────────────────────────────────────────────────────
# auto = NPU when asked for and available, else Ollama, else rules only.
# Set to "none" to run the deterministic rule engine exclusively.
ARIA_LLM_BACKEND=auto
ARIA_OLLAMA_URL=http://localhost:11434
ARIA_OLLAMA_MODEL=gemma3:1b
ARIA_LLM_MAX_TOKENS=1200
ARIA_LLM_TEMPERATURE=0.15
ARIA_LLM_CONTEXT_SIZE=8192
ARIA_LLM_TIMEOUT_SECS=120

# ── Audio ─────────────────────────────────────────────────────────────────────
# noisereduce (fast) | facebook (DNS64, slower, better) | none
ARIA_DENOISER=noisereduce
ARIA_DENOISE_STRENGTH=0.85
ARIA_WHISPER_MODEL=base
ARIA_WHISPER_LANGUAGE=en
ARIA_KEEP_TEMP_AUDIO=0

# ── Retrieval ─────────────────────────────────────────────────────────────────
ARIA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
ARIA_RAG_TOP_K=5
# Below this relevance the report is treated as vague and expanded into
# hypotheses. Raise it to expand more often, lower it to expand less.
ARIA_CONFIDENCE_THRESHOLD=0.55
ARIA_VAGUENESS_MAX_QUERIES=4
ARIA_PERSIST_INDEX=1

# ── Triage ────────────────────────────────────────────────────────────────────
ARIA_TRIAGE_RULES_ENABLED=1
# 1 = merge rule hypotheses with the model's; 0 = rules only as a fallback.
ARIA_TRIAGE_MERGE_RULES=1
ARIA_TRIAGE_MAX_SITUATIONS=4

# ── Queue and escalation ──────────────────────────────────────────────────────
ARIA_SCALE_FACTOR=1000
ARIA_ESCALATION_ENABLED=1
ARIA_ESCALATION_INTERVAL_SECS=60
# Response targets used for the SLA counters on the dashboard.
ARIA_SLA_CRITICAL_MIN=5
ARIA_SLA_HIGH_MIN=30
ARIA_SLA_MEDIUM_MIN=120
ARIA_SLA_LOW_MIN=360

# ── Dispatch ──────────────────────────────────────────────────────────────────
ARIA_VOLUNTEER_COUNT=3
ARIA_MAX_VOLUNTEERS=50
ARIA_AUTO_DISPATCH=1

# ── Inventory ─────────────────────────────────────────────────────────────────
ARIA_REFILL_THRESHOLD=0.60
ARIA_LOW_STOCK_THRESHOLD=0.20
# Minimum score (0-100) before a fuzzy item-name match is trusted. Lowering
# this risks reserving the wrong supply; 82 is already permissive.
ARIA_FUZZY_MIN_SCORE=82

# ── Persistence and logging ───────────────────────────────────────────────────
ARIA_PERSISTENCE_ENABLED=1
ARIA_PERSISTENCE_FLUSH_SECS=2
ARIA_LOG_LEVEL=INFO
ARIA_LOG_TO_FILE=1

# ── Paths (only if you keep data outside the repo) ─────────────────────────────
# ARIA_INVENTORY_CSV=/media/usb/inventory.csv
# ARIA_PROTOCOLS_DIR=/media/usb/protocols
# ARIA_STATE_FILE=/media/usb/aria_state.json
